            if goalSoundId == "" then return end
            local isMe = false
            if typeof(scorerName) == "string" and scorerName == player.Name then isMe = true end
            if typeof(scorerName) == "Instance" and scorerName:IsA("Player") and scorerName == player then isMe = true end
            if isMe then playCustomSound(goalSoundId) end
        end)
    end
end)

