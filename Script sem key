FPSBoost:Section({Title = "CAMERA"})

local FOVValue = 0.5
local FOVEnabled = false
local FOVConnection = nil

FPSBoost:Toggle({
    Title = "FOV",
    Desc = "info: mexa na distancia da sua visao",
    Value = false,
    Callback = function(v)
        FOVEnabled = v
        if v then
            FOVConnection = RunService.RenderStepped:Connect(function()
                if FOVEnabled then
                    local cam = Workspace.CurrentCamera
                    local cf = CFrame.new(0,0,0,FOVValue+0.001,0,0,0,FOVValue+0.001,0,0,0,1)
                    cam.CoordinateFrame = cam.CoordinateFrame * cf
                end
            end)
        else
            if FOVConnection then
                FOVConnection:Disconnect()
                FOVConnection = nil
            end
        end
    end
})

FPSBoost:Slider({
    Title = "FOV VALUE",
    Min = 0,
    Max = 100,
    Rounding = 1,
    Value = 50,
    Callback = function(val)
        FOVValue = (100 - val) / 100
    end
})

