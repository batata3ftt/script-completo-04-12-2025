local selectedColor = Color3.fromRGB(0, 0, 0)
local colorSkillEnabled = false
local colorConnections = {}

local function getChosenColor() return selectedColor end
local function getChosenSeq() return ColorSequence.new(selectedColor) end

local function isMyChar(v)
    local char = player.Character
    return char ~= nil and v:IsDescendantOf(char)
end

local function applyToEffect(v)
    pcall(function()
        if v:IsA("ParticleEmitter") then
            v.Color = getChosenSeq()
        elseif v:IsA("Trail") then
            v.Color = getChosenSeq()
        elseif v:IsA("Beam") then
            v.Color = getChosenSeq()
        end
    end)
end

local function startColorSkill()
    pcall(function()
        local r = math.floor(selectedColor.R * 255)
        local g = math.floor(selectedColor.G * 255)
        local b = math.floor(selectedColor.B * 255)
        player.Ego.Value = r .. "," .. g .. "," .. b
    end)
end

local function stopColorSkill()
    for _, c in pairs(colorConnections) do
        pcall(function() if typeof(c) == "RBXScriptConnection" then c:Disconnect() end end)
    end
    colorConnections = {}
    pcall(function() player.Ego.Value = "NONE" end)
end

local function setColor(nome)
    if COLORS[nome] then
        selectedColor = COLORS[nome]
        WindUI:Notify({
            Title = "COR SELECIONADA",
            Content = nome .. " ativada!",
        })
        if colorSkillEnabled then stopColorSkill() task.wait(0.1) startColorSkill() end
    end
end

