local function playCustomSound(soundId)
    if not soundId or soundId == "" then return end
    local id = tostring(soundId):match("%d+")
    if not id then return end
    local sound = Instance.new("Sound")
    sound.SoundId = "rbxassetid://" .. id
    sound.Volume = 2
    sound.Parent = Workspace
    sound:Play()
    sound.Ended:Connect(function() sound:Destroy() end)
end

-- ========== RAGDOLL SOUND MELHORADO ==========
-- Usa TackleHit_RE como trigger principal (mais confiavel)
-- + fallback por StateChanged/BallSocketConstraint

local soundPlayed = {}       -- [userId] = bool
local soundCooldown = {}     -- [userId] = tick()
local SOUND_COOLDOWN = 2.5   -- segundos entre sons do mesmo player

-- Janela de tempo apos tackle para aceitar ragdoll
local lastTackleHit = 0
local TACKLE_WINDOW = 1.5

-- Escuta TackleHit_RE â€” dispara quando QUALQUER tackle acerta alguem
pcall(function()
    local TackleHitRE = ReplicatedStorage:WaitForChild("TackleHit_RE", 10)
    if TackleHitRE then
        TackleHitRE.OnClientEvent:Connect(function(...)
            -- Verifica se o player local foi o causador
            -- (a bola precisa estar proxima OU o player estava perto de alguem)
            local char = player.Character
            if not char then return end
            local hrp = char:FindFirstChild("HumanoidRootPart")
            if not hrp then return end

            -- Marca janela de tackle para qualquer ragdoll proxima
            lastTackleHit = tick()
        end)
    end
end)

-- Tambem monitora Tackle_RE para ampliar a janela
pcall(function()
    local TackleRE = ReplicatedStorage:WaitForChild("Tackle_RE", 10)
    if TackleRE then
        TackleRE.OnClientEvent:Connect(function(...)
            lastTackleHit = tick()
        end)
    end
end)

local function isRecentTackle()
    return (tick() - lastTackleHit) <= TACKLE_WINDOW
end

local function canPlayForPlayer(p)
    if not p then return false end
    local t = soundCooldown[p.UserId]
    if not t then return true end
    return (tick() - t) >= SOUND_COOLDOWN
end

local function monitorRagdollCharacter(p, character)
    if p == player then return end
    local humanoid = character:WaitForChild("Humanoid")
    soundPlayed[p.UserId] = false

    local function tryPlay()
        if ragdollSoundId == "" then return end
        if not isRecentTackle() then return end
        if not canPlayForPlayer(p) then return end

        soundCooldown[p.UserId] = tick()
        soundPlayed[p.UserId] = true
        playCustomSound(ragdollSoundId)

        task.delay(SOUND_COOLDOWN, function()
            soundPlayed[p.UserId] = false
        end)
    end

    -- Metodo 1: StateChanged (mais direto)
    humanoid.StateChanged:Connect(function(oldState, newState)
        if (newState == Enum.HumanoidStateType.Ragdoll or
            newState == Enum.HumanoidStateType.FallingDown) and
           oldState ~= Enum.HumanoidStateType.Ragdoll and
           oldState ~= Enum.HumanoidStateType.FallingDown then
            tryPlay()
        end
    end)

    -- Metodo 2: BoolValue ragdoll
    local function checkBool(obj)
        if obj:IsA("BoolValue") and obj.Name:lower():find("ragdoll") then
            local lastVal = obj.Value
            obj:GetPropertyChangedSignal("Value"):Connect(function()
                if obj.Value == true and lastVal == false then tryPlay() end
                lastVal = obj.Value
            end)
        end
    end

    for _, obj in pairs(character:GetDescendants()) do checkBool(obj) end
    character.DescendantAdded:Connect(function(obj)
        checkBool(obj)
        -- Metodo 3: BallSocketConstraint = ragdoll fisico
        if obj:IsA("BallSocketConstraint") then tryPlay() end
    end)

    -- Metodo 4: Atributo Ragdoll
    pcall(function()
        local lastRagdollAttr = false
        character:GetAttributeChangedSignal("Ragdoll"):Connect(function()
            local val = character:GetAttribute("Ragdoll")
            if val == true and lastRagdollAttr == false then tryPlay() end
            lastRagdollAttr = val
        end)
    end)

    -- Metodo 5: Heartbeat monitorando state (fallback)
    local wasRagdoll = false
    local hbConn
    hbConn = RunService.Heartbeat:Connect(function()
        if not character.Parent then
            hbConn:Disconnect()
            return
        end
        local state = humanoid:GetState()
        local isNow = state == Enum.HumanoidStateType.Ragdoll or
                      state == Enum.HumanoidStateType.FallingDown
        if isNow and not wasRagdoll then
            wasRagdoll = true
            tryPlay()
        elseif not isNow then
            wasRagdoll = false
        end
    end)
end

for _, p in pairs(Players:GetPlayers()) do
    if p ~= player then
        if p.Character then monitorRagdollCharacter(p, p.Character) end
