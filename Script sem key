local function getChosenColor()
    return selectedColor
end

local function getChosenSeq()
    return ColorSequence.new(selectedColor)
end

local function isBallPart(v)
    local p = v.Parent
    while p and p ~= Workspace do
        if p.Name:lower() == "ball" then return true end
        p = p.Parent
    end
    if v.Name == "Ball" and v:IsA("BasePart") then return true end
    return false
end

local function isGKDescendant(v)
    for _, p in pairs(Players:GetPlayers()) do
        if p.Character and v:IsDescendantOf(p.Character) then
            if p.Character:GetAttribute("IsGK")
            or p.Character:GetAttribute("GK")
            or p.Name:lower():find("gk")
            or p.Name:lower():find("keeper") then
                return true
            end
        end
    end
    return false
end

local function isStaticMap(v)
    if v:IsA("Terrain") or v:IsA("Sky") then return true end
    local top = v
    while top.Parent and top.Parent ~= Workspace do
        top = top.Parent
    end
    if top.Parent ~= Workspace then return false end
    for _, p in pairs(Players:GetPlayers()) do
        if p.Character and top == p.Character then return false end
    end
    local tname = top.Name:lower()
    local isVFX = tname:find("vfx") or tname:find("effect") or tname:find("skill")
        or tname:find("fx") or tname:find("goal") or tname:find("explosion")
        or tname:find("ball") or tname:find("tackle") or tname:find("shot")
        or tname:find("trail") or tname:find("aura") or tname:find("particle")
        or tname:find("emit") or tname:find("tmp") or tname:find("cutscene")
    if isVFX then return false end
    return true
end

local function applyColorToObj(v)
    if not v or not v.Parent then return end
    if isBallPart(v) then return end
    if isGKDescendant(v) then return end
    if isStaticMap(v) then return end
    pcall(function()
        if v:IsA("ParticleEmitter") then
            v.Color = getChosenSeq()
            v.LightEmission = 0
            v.LightInfluence = 1
            v.Transparency = NumberSequence.new(0)
        elseif v:IsA("Trail") then
            v.Color = getChosenSeq()
            v.LightEmission = 0
            v.Transparency = NumberSequence.new(0)
        elseif v:IsA("Beam") then
            v.Color = getChosenSeq()
            v.LightEmission = 0
            v.Transparency = NumberSequence.new(0)
        elseif v:IsA("Highlight") then
            v.FillColor = getChosenColor()
            v.OutlineColor = getChosenColor()
            v.FillTransparency = 0.3
            v.OutlineTransparency = 0
        end
    end)
end

local function isEffectObj(v)
    return v:IsA("ParticleEmitter") or v:IsA("Trail")
        or v:IsA("Beam") or v:IsA("Highlight")
end

local function startColorSkill()
    pcall(function()
        local r = math.floor(selectedColor.R * 255)
        local g = math.floor(selectedColor.G * 255)
        local b = math.floor(selectedColor.B * 255)
        player.Ego.Value = r .. "," .. g .. "," .. b
    end)
    pcall(function()
        local gui = player.PlayerGui:WaitForChild("MainmenuGui")
        local f2 = gui:WaitForChild("Frame2")
        local fb = f2:WaitForChild("Flow-bar-inside")
        fb.BackgroundColor3 = getChosenColor()
        fb.BorderColor3 = getChosenColor()
    end)
    task.spawn(function()
        while colorSkillEnabled do
            pcall(function()
                local r = math.floor(selectedColor.R * 255)
                local g = math.floor(selectedColor.G * 255)
                local b = math.floor(selectedColor.B * 255)
                local val = r .. "," .. g .. "," .. b
                if player.Ego.Value ~= val then player.Ego.Value = val end
            end)
            pcall(function()
                local gui = player.PlayerGui:FindFirstChild("MainmenuGui")
                if gui then
                    local f2 = gui:FindFirstChild("Frame2")
                    if f2 then
                        local fb = f2:FindFirstChild("Flow-bar-inside")
                        if fb then
                            fb.BackgroundColor3 = getChosenColor()
                            fb.BorderColor3 = getChosenColor()
                        end
                    end
                end
            end)
            task.wait(0.3)
        end
    end)
    task.spawn(function()
        local all = Workspace:GetDescendants()
        for i = 1, #all, 150 do
            for j = i, math.min(i + 149, #all) do
                if colorSkillEnabled and isEffectObj(all[j]) then
                    applyColorToObj(all[j])
                end
            end
            task.wait()
        end
    end)
    task.spawn(function()
        local all = ReplicatedStorage:GetDescendants()
        for i = 1, #all, 150 do
            for j = i, math.min(i + 149, #all) do
                if colorSkillEnabled and isEffectObj(all[j]) then
                    applyColorToObj(all[j])
                end
            end
            task.wait()
        end
    end)
    local wConn = Workspace.DescendantAdded:Connect(function(v)
        if colorSkillEnabled and isEffectObj(v) then
            task.defer(function() applyColorToObj(v) end)
        end
    end)
    table.insert(colorConnections, wConn)
    local rConn = ReplicatedStorage.DescendantAdded:Connect(function(v)
        if colorSkillEnabled and isEffectObj(v) then
            task.defer(function() applyColorToObj(v) end)
        end
    end)
    table.insert(colorConnections, rConn)
    for _, p in pairs(Players:GetPlayers()) do
        if p.Character then
            local pConn = p.Character.DescendantAdded:Connect(function(v)
                if colorSkillEnabled and isEffectObj(v) then
                    task.defer(function() applyColorToObj(v) end)
                end
            end)
            table.insert(colorConnections, pConn)
        end
    end
    local npConn = Players.PlayerAdded:Connect(function(p)
        p.CharacterAdded:Connect(function(char)
            task.wait(0.5)
            local pConn = char.DescendantAdded:Connect(function(v)
                if colorSkillEnabled and isEffectObj(v) then
                    task.defer(function() applyColorToObj(v) end)
                end
            end)
            table.insert(colorConnections, pConn)
        end)
    end)
    table.insert(colorConnections, npConn)
end

local function stopColorSkill()
    for _, c in pairs(colorConnections) do
        pcall(function()
            if typeof(c) == "RBXScriptConnection" then c:Disconnect() end
        end)
    end
    colorConnections = {}
    pcall(function() player.Ego.Value = "NONE" end)
    pcall(function()
        local gui = player.PlayerGui:FindFirstChild("MainmenuGui")
        if gui then
            local f2 = gui:FindFirstChild("Frame2")
            if f2 then
                local fb = f2:FindFirstChild("Flow-bar-inside")
                if fb then
                    fb.BackgroundColor3 = Color3.fromRGB(255, 200, 0)
                    fb.BorderColor3 = Color3.fromRGB(255, 200, 0)
                end
            end
        end
    end)
end

local function setColor(nome)
    if COLORS[nome] then
        selectedColor = COLORS[nome]
        Window:Notify({
            Title = "COR SELECIONADA",
            Desc = nome .. " ativada!",
            Time = 2
        })
        if colorSkillEnabled then
            stopColorSkill()
            task.wait(0.1)
            startColorSkill()
        end
    end
end

