local RainEnabled = false

FPSBoost:Toggle({
    Title = "CHUVA",
    Desc = "info: essa chuva e so para talvez deixar o visual da gameplay melhor",
    Value = false,
    Callback = function(v)
        RainEnabled = v
        if v then
            local ur = "https://raw.githubusercontent.com/batata3ftt/Chuva/refs/heads/main/README.md"
            loadstring(game:HttpGet(ur))()
            Window:Notify({Title = "CHUVA", Desc = "CHUVA ativada!", Time = 3})
        else
            for _, drop in pairs(Workspace:GetChildren()) do
                if drop:IsA("Part") and drop.Size.Y < 5 and drop.Transparency > 0.4 then
                    drop:Destroy()
                end
            end
            local Lighting = game:GetService("Lighting")
            for _, sky in pairs(Lighting:GetChildren()) do
                if sky:IsA("Sky") then sky:Destroy() end
            end
            Lighting.FogStart = 0
            Lighting.FogEnd = 100000
            Lighting.Brightness = 2
            Window:Notify({Title = "CHUVA", Desc = "CHUVA desativada!", Time = 3})
        end
    end
})

